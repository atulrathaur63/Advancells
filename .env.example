# Advancells HRMS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Application Environment ('development' or 'production')
APP_ENV=development
APP_NAME="Advancells HRMS"

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=advancells_hrms

# Session Configuration
# Idle session timeout in seconds (1800 = 30 minutes)
SESSION_IDLE_TIMEOUT=1800
